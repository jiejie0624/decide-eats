# Server only. Never prefix this with NEXT_PUBLIC_.
ASSEMBLYAI_API_KEY=

# Optional. Use a stored AssemblyAI Voice Agent instead of the inline M1 prompt.
NEXT_PUBLIC_ASSEMBLYAI_AGENT_ID=

# Optional for M2 live restaurant results. Without this, the app uses marked demo results.
FOURSQUARE_API_KEY=
FOURSQUARE_API_VERSION=2025-06-17

# Optional. Enables smarter worldwide location resolving for spoken/typed areas.
# Keep this server-only; do not prefix with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=

DEFAULT_SEARCH_LATITUDE=1.519901
DEFAULT_SEARCH_LONGITUDE=103.6586369
DEFAULT_SEARCH_LABEL=Taman Ungku Tun Aminah
